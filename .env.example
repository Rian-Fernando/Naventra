# URL of the always-on Cloudflare tracker worker (no trailing slash).
# Leave unset to run purely client-side with per-browser learning.
# Local dev:      http://localhost:8787
# Production:     https://naventra-tracker.<your-subdomain>.workers.dev
VITE_TRACKER_URL=

# Feedex feedback widget — publishable key (starts with pk_fdx_).
# Leave BOTH unset locally so dev never posts into the real feedback inbox; when
# unset, the widget script is simply not injected (a console warning is printed).
#
# ENV-VAR TRAP: Vite only exposes VITE_-prefixed vars to client code, so a key
# named NEXT_PUBLIC_FEEDEX_KEY (what Feedex's docs and the Vercel dashboard use)
# is invisible to `import.meta.env`. The widget is therefore injected from the
# Vite config (Node, build time), which reads either name — preferring VITE_.
# Set EITHER of these (VITE_ wins if both are present):
VITE_FEEDEX_KEY=
# NEXT_PUBLIC_FEEDEX_KEY=pk_fdx_...   # already set in Vercel for production
